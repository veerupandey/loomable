# Copy to .env in the repo root (never commit .env).
# .env is gitignored.

# Gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# OpenAI
# OPENAI_API_KEY=

# Azure OpenAI
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT_NAME=
# AZURE_OPENAI_API_VERSION=2024-10-21

# Amazon Bedrock (uses the standard AWS credential chain: env / profile / SSO)
# Install: pip install "loomable[bedrock]"
# Newer models use cross-region inference profiles with a geo prefix:
#   us. (Americas), eu. (Europe), apac. (Asia Pacific) — match it to AWS_REGION.
# List available ids: aws bedrock list-inference-profiles --region <region>
# AWS_REGION=us-east-1
# AWS_PROFILE=default
# BEDROCK_MODEL=amazon.nova-lite-v1:0
# Requires the caller to have bedrock:InvokeModel and model access enabled.

# Optional live Postgres (docker compose)
# POSTGRES_URL=postgresql://loomable:loomable@127.0.0.1:5432/loomable
